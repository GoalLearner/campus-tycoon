{
  "name": "campus-tycoon",
  "private": true,
  "version": "0.0.1",
  "license": "UNLICENSED",
  "description": "A mobile idle game where you run a fictional university.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "art": "python tools/build_art.py",
    "phone": "vite --host"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
